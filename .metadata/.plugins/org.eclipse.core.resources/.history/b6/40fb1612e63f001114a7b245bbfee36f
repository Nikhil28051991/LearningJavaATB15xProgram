package orderhistory;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import java.io.FileInputStream;
import java.time.LocalDate;
import java.util.*;

public class OrderReportTable {

    private static class Stats {
        int count = 0;
        double totalPrice = 0.0;

        void add(double price) {
            count++;
            totalPrice += price;
        }

        String format() {
            return String.format("%d (%.0f)", count, totalPrice);
        }
    }

    private static final String[] PAYMENT_ORDER = {
            "UPI", "CC", "UPIPPI", "UPICC", "NB", "UPI SALE", "CARD", "CASH"
    };

    public static void main(String[] args) {

        String filePath = "C:\\Users\\Nikhil Sonawane\\eclipse-workspace\\OrderReport\\2026-04-01 to 2026-04-15_Order_History.xlsx";

        Map<LocalDate, Map<String, Stats>> dailyData = new TreeMap<>();
        Map<String, Stats> grandTotals = new HashMap<>();
        Map<LocalDate, Stats> dayTotals = new HashMap<>();
        Stats overallTotal = new Stats();

        try (FileInputStream fis = new FileInputStream(filePath);
             Workbook wb = new XSSFWorkbook(fis)) {

            Sheet sheet = wb.getSheetAt(0);

            // ✅ AUTO-DETECT COLUMNS
            Row header = sheet.getRow(0);
            Map<String, Integer> colMap = new HashMap<>();

            for (Cell cell : header) {
                String name = cell.getStringCellValue().trim().toLowerCase();
                colMap.put(name, cell.getColumnIndex());
            }

            // 👉 CHANGE THESE NAMES if needed (based on your Excel)
            int dateCol = getColumn(colMap, "date");
            int payCol = getColumn(colMap, "payment");
            int priceCol = getColumn(colMap, "price");

            System.out.println("Detected Columns → Date:" + dateCol +
                    " Payment:" + payCol + " Price:" + priceCol);

            for (int r = 1; r <= sheet.getLastRowNum(); r++) {
                Row row = sheet.getRow(r);
                if (row == null) continue;

                // ✅ DATE
                Cell dateCell = row.getCell(dateCol);
                if (dateCell == null) continue;

                LocalDate date = null;

                try {
                    if (dateCell.getCellType() == CellType.NUMERIC) {
                        date = dateCell.getLocalDateTimeCellValue().toLocalDate();
                    } else {
                        String d = dateCell.toString().trim();
                        if (!d.isEmpty()) {
                            date = LocalDate.parse(d.substring(0, 10));
                        }
                    }
                } catch (Exception e) {
                    System.out.println("Skipping bad date at row " + r);
                    continue;
                }

                // ✅ PAYMENT
                Cell payCell = row.getCell(payCol);
                String payment = "Unknown";

                if (payCell != null) {
                    payment = payCell.toString().toUpperCase().trim();
                    payment = payment.replace("_", " ");
                }

                // ✅ PRICE
                Cell priceCell = row.getCell(priceCol);
                double price = 0;

                if (priceCell != null) {
                    try {
                        if (priceCell.getCellType() == CellType.NUMERIC) {
                            price = priceCell.getNumericCellValue();
                        } else {
                            price = Double.parseDouble(
                                    priceCell.toString().replace(",", "").trim()
                            );
                        }
                    } catch (Exception ignored) {}
                }

                // ✅ AGGREGATE
                dailyData
                        .computeIfAbsent(date, k -> new HashMap<>())
                        .computeIfAbsent(payment, k -> new Stats())
                        .add(price);

                dayTotals.computeIfAbsent(date, k -> new Stats()).add(price);
                grandTotals.computeIfAbsent(payment, k -> new Stats()).add(price);
                overallTotal.add(price);
            }

        } catch (Exception e) {
            e.printStackTrace();
            return;
        }

        // ================= TABLE =================

        List<String[]> table = new ArrayList<>();

        String[] headerRow = new String[PAYMENT_ORDER.length + 2];
        headerRow[0] = "Date";
        System.arraycopy(PAYMENT_ORDER, 0, headerRow, 1, PAYMENT_ORDER.length);
        headerRow[headerRow.length - 1] = "Total";
        table.add(headerRow);

        for (LocalDate date : dailyData.keySet()) {
            Map<String, Stats> map = dailyData.get(date);
            Stats total = dayTotals.get(date);

            String[] row = new String[PAYMENT_ORDER.length + 2];
            row[0] = date.toString();

            for (int i = 0; i < PAYMENT_ORDER.length; i++) {
                Stats s = map.get(PAYMENT_ORDER[i]);
                row[i + 1] = (s != null) ? s.format() : "0 (0)";
            }

            row[row.length - 1] = total.format();
            table.add(row);
        }

        // GRAND TOTAL
        String[] grand = new String[PAYMENT_ORDER.length + 2];
        grand[0] = "GRAND TOTAL";

        for (int i = 0; i < PAYMENT_ORDER.length; i++) {
            grand[i + 1] = grandTotals.getOrDefault(PAYMENT_ORDER[i], new Stats()).format();
        }
        grand[grand.length - 1] = overallTotal.format();
        table.add(grand);

        // TOTAL ROW
        String totalStr = overallTotal.format();
        String[] totalRow = new String[PAYMENT_ORDER.length + 2];
        totalRow[0] = "TOTAL";
        Arrays.fill(totalRow, 1, totalRow.length, totalStr);
        table.add(totalRow);

        printTable(table);
    }

    // 🔍 Helper to find column by keyword
    private static int getColumn(Map<String, Integer> map, String keyword) {
        for (String key : map.keySet()) {
            if (key.contains(keyword)) {
                return map.get(key);
            }
        }
        throw new RuntimeException("Column not found: " + keyword);
    }

    // ================= PRINT =================

    private static void printTable(List<String[]> rows) {
        int cols = rows.get(0).length;
        int[] widths = new int[cols];

        for (String[] row : rows) {
            boolean bold = row[0].equals("GRAND TOTAL") || row[0].equals("TOTAL");

            for (int c = 0; c < cols; c++) {
                String val = bold ? "**" + row[c] + "**" : row[c];
                widths[c] = Math.max(widths[c], val.length());
            }
        }

        StringBuilder line = new StringBuilder("+");
        for (int w : widths) line.append("-".repeat(w + 2)).append("+");

        System.out.println(line);
        printRow(rows.get(0), widths);
        System.out.println(line);

        for (int i = 1; i < rows.size(); i++) {
            printRow(rows.get(i), widths);
            if (rows.get(i)[0].equals("GRAND TOTAL")) {
                System.out.println(line);
            }
        }

        System.out.println(line);
    }

    private static void printRow(String[] row, int[] widths) {
        boolean bold = row[0].equals("GRAND TOTAL") || row[0].equals("TOTAL");

        System.out.print("|");
        for (int c = 0; c < row.length; c++) {
            String val = bold ? "**" + row[c] + "**" : row[c];

            if (c == 0) {
                System.out.printf(" %-"+widths[c]+"s |", val);
            } else {
                System.out.printf(" %"+widths[c]+"s |", val);
            }
        }
        System.out.println();
    }
}