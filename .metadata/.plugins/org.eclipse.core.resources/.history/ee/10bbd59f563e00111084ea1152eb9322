package orderhistory;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import java.io.FileInputStream;
import java.time.LocalDate;
import java.time.ZoneId;
import java.util.*;

public class OrderReportTable {

    private static class Stats {
        int count = 0;
        double totalPrice = 0.0;

        void add(double price) {
            count++;
            totalPrice += price; // ✅ correct
        }

        String format() {
            return String.format("%d (%.0f)", count, totalPrice);
        }
    }

    // ✅ Fixed order (your preference)
    private static final List<String> FIXED_PAYMENT_ORDER = Arrays.asList(
            "UPI", "CC", "UPIPPI", "UPICC", "NB", "UPI SALE", "CARD", "CASH"
    );

    public static void main(String[] args) {

        String filePath = "C:\\Users\\Nikhil Sonawane\\eclipse-workspace\\OrderReport\\2026-04-01 to 2026-04-15_Order_History.xlsx";

        Map<LocalDate, Map<String, Stats>> dailyData = new TreeMap<>();
        Map<String, Stats> grandTotals = new HashMap<>();
        Map<LocalDate, Stats> dayTotals = new HashMap<>();
        Stats overallTotal = new Stats();

        Set<String> paymentTypes = new HashSet<>();
        DataFormatter formatter = new DataFormatter();

        try (FileInputStream fis = new FileInputStream(filePath);
             Workbook wb = new XSSFWorkbook(fis)) {

            Sheet sheet = wb.getSheet("Order History");
            if (sheet == null) {
                System.err.println("Sheet 'Order History' not found!");
                return;
            }

            for (int r = 1; r <= sheet.getLastRowNum(); r++) {

                Row row = sheet.getRow(r);
                if (row == null) continue;

                // ================= DATE =================
                Cell dateCell = row.getCell(8);
                if (dateCell == null) continue;

                LocalDate date;

                try {
                    if (dateCell.getCellType() == CellType.NUMERIC &&
                            DateUtil.isCellDateFormatted(dateCell)) {

                        date = dateCell.getDateCellValue()
                                .toInstant()
                                .atZone(ZoneId.systemDefault())
                                .toLocalDate();

                    } else {
                        String dateStr = formatter.formatCellValue(dateCell).trim();
                        if (dateStr.isEmpty()) continue;
                        date = LocalDate.parse(dateStr);
                    }
                } catch (Exception e) {
                    System.out.println("Skipping invalid date at row: " + r);
                    continue;
                }

                // ================= PAYMENT =================
                Cell payCell = row.getCell(9);
                String payment = formatter.formatCellValue(payCell).trim();
                if (payment.isEmpty()) payment = "Unknown";

                paymentTypes.add(payment);

                // ================= PRICE =================
                Cell priceCell = row.getCell(5);
                double price = 0.0;

                try {
                    String priceStr = formatter.formatCellValue(priceCell)
                            .replace(",", "").trim();

                    if (!priceStr.isEmpty()) {
                        price = Double.parseDouble(priceStr);
                    }
                } catch (Exception ignored) {}

                // ================= AGGREGATION =================
                dailyData
                        .computeIfAbsent(date, k -> new HashMap<>())
                        .computeIfAbsent(payment, k -> new Stats())
                        .add(price);

                dayTotals.computeIfAbsent(date, k -> new Stats()).add(price);
                grandTotals.computeIfAbsent(payment, k -> new Stats()).add(price);
                overallTotal.add(price);
            }

        } catch (Exception e) {
            System.err.println("Error reading Excel: " + e.getMessage());
            e.printStackTrace();
            return;
        }

        // ✅ Merge fixed + dynamic categories
        Set<String> allPayments = new LinkedHashSet<>(FIXED_PAYMENT_ORDER);
        allPayments.addAll(paymentTypes);

        List<String> PAYMENT_ORDER = new ArrayList<>(allPayments);

        // ================= BUILD TABLE =================
        List<String[]> table = new ArrayList<>();

        // Header
        String[] header = new String[PAYMENT_ORDER.size() + 2];
        header[0] = "Date";

        for (int i = 0; i < PAYMENT_ORDER.size(); i++) {
            header[i + 1] = PAYMENT_ORDER.get(i);
        }

        header[header.length - 1] = "Total";
        table.add(header);

        // Daily rows
        for (LocalDate date : dailyData.keySet()) {

            Map<String, Stats> dayMap = dailyData.get(date);
            Stats dayTotal = dayTotals.get(date);

            String[] row = new String[PAYMENT_ORDER.size() + 2];
            row[0] = date.toString();

            for (int i = 0; i < PAYMENT_ORDER.size(); i++) {
                Stats s = dayMap.get(PAYMENT_ORDER.get(i));
                row[i + 1] = (s != null) ? s.format() : "0 (0)";
            }

            row[row.length - 1] = dayTotal.format();
            table.add(row);
        }

        // GRAND TOTAL
        String[] grandRow = new String[PAYMENT_ORDER.size() + 2];
        grandRow[0] = "GRAND TOTAL";

        for (int i = 0; i < PAYMENT_ORDER.size(); i++) {
            Stats s = grandTotals.getOrDefault(PAYMENT_ORDER.get(i), new Stats());
            grandRow[i + 1] = s.format();
        }

        grandRow[grandRow.length - 1] = overallTotal.format();
        table.add(grandRow);

        // FINAL TOTAL
        String totalStr = overallTotal.format();
        String[] finalRow = new String[PAYMENT_ORDER.size() + 2];
        finalRow[0] = "TOTAL";
        Arrays.fill(finalRow, 1, finalRow.length, totalStr);
        table.add(finalRow);

        printTable(table);
    }

    // ================= PRINT =================
    private static void printTable(List<String[]> rows) {

        int cols = rows.get(0).length;
        int[] widths = new int[cols];

        for (String[] row : rows) {
            for (int c = 0; c < cols; c++) {
                widths[c] = Math.max(widths[c], row[c].length());
            }
        }

        String line = "+" + java.util.stream.IntStream.range(0, cols)
                .mapToObj(i -> "-".repeat(widths[i] + 2))
                .reduce((a, b) -> a + "+" + b).orElse("") + "+";

        System.out.println(line);

        for (int i = 0; i < rows.size(); i++) {

            boolean bold = (i == rows.size() - 2 || i == rows.size() - 1);

            printRow(rows.get(i), widths, bold);

            if (i == 0 || i == rows.size() - 3 || i == rows.size() - 2) {
                System.out.println(line);
            }
        }

        System.out.println(line);
    }

    private static void printRow(String[] row, int[] widths, boolean bold) {

        for (int c = 0; c < row.length; c++) {

            String cell = row[c];

            if (bold) {
                cell = "**" + cell + "**";
            }

            String fmt = (c == 0) ? "%-" + widths[c] + "s" : "%" + widths[c] + "s";
            System.out.print("| " + String.format(fmt, cell) + " ");
        }

        System.out.println("|");
    }
}