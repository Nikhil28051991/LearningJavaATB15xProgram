package com.everycred.everycred_automation;

import java.time.Duration;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import io.github.bonigarcia.wdm.WebDriverManager;

public class EveryCredLogin {

    public static void main(String[] args) {

        WebDriverManager.chromedriver().setup();
        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();

        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));

        try {
            driver.get("https://stg-dcs-issuer.everycred.com/auth/login");

            wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("email")))
                    .sendKeys("everycred@maildrop.cc");

            wait.until(ExpectedConditions.visibilityOfElementLocated(By.cssSelector("input[type='password']")))
                    .sendKeys("Everycred@123");

            wait.until(ExpectedConditions.elementToBeClickable(
                    By.xpath("//button[@type='submit']//span[text()='Sign In']/parent::button")))
                    .click();

            // Wait so you can see the logged-in account
            Thread.sleep(60000); // 60 seconds

            System.out.println("Login Successful ✅ Browser will remain open");

        } catch (Exception e) {
            e.printStackTrace();
        }

        // ❌ DO NOT quit driver
        // driver.quit();
    }
}
