package orderhistory;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import java.io.FileInputStream;
import java.time.LocalDate;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;

public class OrderReportTable {

    // ===== Stats Class =====
    static class Stats {
        int count = 0;
        double total = 0;

        void add(double price) {
            count++;
            total += price;
        }

        String format() {
            return count == 0 ? "0 (0)" : count + " (" + (long) total + ")";
        }
    }

    // ===== Fixed Payment Order =====
    static final List<String> PAYMENT_ORDER = Arrays.asList(
            "UPI", "CC", "UPIINT", "UPIICC", "NB", "UPI SALE", "CARD", "CASH"
    );

    public static void main(String[] args) {

        String filePath = "C:\\Users\\Nikhil Sonawane\\eclipse-workspace\\OrderReport\\2026-04-01 to 2026-04-15_Order_History.xlsx";

        // Date → Payment → Stats
        Map<LocalDate, Map<String, Stats>> data = new TreeMap<>();

        DataFormatter formatter = new DataFormatter();

        try (FileInputStream fis = new FileInputStream(filePath);
             Workbook workbook = new XSSFWorkbook(fis)) {

            Sheet sheet = workbook.getSheetAt(0);

            for (int i = 1; i <= sheet.getLastRowNum(); i++) {

                Row row = sheet.getRow(i);
                if (row == null) continue;

                // ================= DATE =================
                LocalDate date = null;
                Cell dateCell = row.getCell(8);

                try {
                    if (dateCell == null) continue;

                    if (dateCell.getCellType() == CellType.NUMERIC &&
                            DateUtil.isCellDateFormatted(dateCell)) {

                        date = dateCell.getDateCellValue()
                                .toInstant()
                                .atZone(ZoneId.systemDefault())
                                .toLocalDate();

                    } else {
                        String dateStr = formatter.formatCellValue(dateCell).trim();

                        if (dateStr.isEmpty()) continue;

                        // Try multiple formats
                        try {
                            date = LocalDate.parse(dateStr);
                        } catch (Exception e1) {
                            try {
                                date = LocalDate.parse(dateStr, DateTimeFormatter.ofPattern("dd-MM-yyyy"));
                            } catch (Exception e2) {
                                date = LocalDate.parse(dateStr, DateTimeFormatter.ofPattern("dd/MM/yyyy"));
                            }
                        }
                    }

                } catch (Exception e) {
                    continue;
                }

                // ================= PAYMENT =================
                String payment = formatter.formatCellValue(row.getCell(9)).trim();
                if (payment.isEmpty()) payment = "UNKNOWN";

                // ================= PRICE =================
                double price = 0;
                try {
                    String priceStr = formatter.formatCellValue(row.getCell(5)).replace(",", "").trim();
                    if (!priceStr.isEmpty()) {
                        price = Double.parseDouble(priceStr);
                    }
                } catch (Exception ignored) {}

                // ================= STORE =================
                data
                        .computeIfAbsent(date, d -> new HashMap<>())
                        .computeIfAbsent(payment, p -> new Stats())
                        .add(price);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        // ================= PRINT TABLE =================

        // Header
        System.out.printf("%-12s", "Date");
        for (String p : PAYMENT_ORDER) {
            System.out.printf("| %-15s", p);
        }
        System.out.printf("| %-15s\n", "Total");

        System.out.println("--------------------------------------------------------------------------------------------------------------");

        // Data Rows
        for (LocalDate date : data.keySet()) {

            Map<String, Stats> map = data.get(date);

            System.out.printf("%-12s", date);

            int totalCount = 0;
            double totalAmount = 0;

            for (String p : PAYMENT_ORDER) {
                Stats s = map.getOrDefault(p, new Stats());

                System.out.printf("| %-15s", s.format());

                totalCount += s.count;
                totalAmount += s.total;
            }

            System.out.printf("| %-15s\n", totalCount + " (" + (long) totalAmount + ")");
        }

        // ================= GRAND TOTAL =================
        System.out.println("--------------------------------------------------------------------------------------------------------------");

        int grandCount = 0;
        double grandAmount = 0;

        Map<String, Stats> grandMap = new HashMap<>();

        for (Map<String, Stats> map : data.values()) {
            for (String p : map.keySet()) {
                Stats s = map.get(p);

                grandMap.computeIfAbsent(p, k -> new Stats()).add(s.total);
                grandMap.get(p).count += (s.count - 1); // adjust double count
            }
        }

        System.out.printf("%-12s", "GRAND TOTAL");

        for (String p : PAYMENT_ORDER) {
            Stats s = grandMap.getOrDefault(p, new Stats());
            System.out.printf("| %-15s", s.format());

            grandCount += s.count;
            grandAmount += s.total;
        }

        System.out.printf("| %-15s\n", grandCount + " (" + (long) grandAmount + ")");
    }
}