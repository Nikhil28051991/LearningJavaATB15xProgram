package orderhistory;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import java.io.FileInputStream;
import java.time.LocalDate;
import java.util.*;

public class OrderReportTable2 {

    static class Stats {
        int count = 0;
        double amount = 0;

        void add(double price) {
            count++;
            amount += price;
        }

        String format() {
            return String.format("%d (%.0f)", count, amount);
        }
    }

    private static final String[] PAYMENT_ORDER = {
            "UPI", "CC", "UPIPPI", "UPICC", "NB", "UPI SALE", "CARD", "CASH"
    };

    public static void main(String[] args) {

        String filePath = "C:\\Users\\Nikhil Sonawane\\eclipse-workspace\\OrderReport\\2026-03-16 to 2026-03-31_Order_History.xlsx";

        Map<LocalDate, Map<String, Stats>> daily = new TreeMap<>();
        Map<String, Stats> grand = new HashMap<>();
        Map<LocalDate, Stats> dayTotal = new HashMap<>();
        Stats overall = new Stats();

        try (FileInputStream fis = new FileInputStream(filePath);
             Workbook wb = new XSSFWorkbook(fis)) {

            Sheet sheet = wb.getSheetAt(0);

            Row header = sheet.getRow(0);
            Map<String, Integer> cols = new HashMap<>();

            for (Cell c : header) {
                cols.put(c.getStringCellValue().toLowerCase().trim(), c.getColumnIndex());
            }

            int dateCol = findColumn(cols, "purchased");
            int payCol = findColumn(cols, "payment");
            int priceCol = findColumn(cols, "ticket");

            System.out.println("Using columns -> Date:" + dateCol +
                    " Payment:" + payCol + " Price:" + priceCol);

            for (int r = 1; r <= sheet.getLastRowNum(); r++) {
                Row row = sheet.getRow(r);
                if (row == null) continue;

                Cell dc = row.getCell(dateCol);
                if (dc == null) continue;

                LocalDate date;
                try {
                    if (dc.getCellType() == CellType.NUMERIC) {
                        date = dc.getLocalDateTimeCellValue().toLocalDate();
                    } else {
                        String d = dc.toString().trim();
                        date = LocalDate.parse(d.substring(0, 10));
                    }
                } catch (Exception e) {
                    continue;
                }

                String payment = "UNKNOWN";
                Cell pc = row.getCell(payCol);
                if (pc != null) {
                    payment = pc.toString().toUpperCase().trim().replace("_", " ");
                }

                double price = 0;
                Cell pr = row.getCell(priceCol);
                if (pr != null) {
                    try {
                        if (pr.getCellType() == CellType.NUMERIC) {
                            price = pr.getNumericCellValue();
                        } else {
                            price = Double.parseDouble(pr.toString().replace(",", "").trim());
                        }
                    } catch (Exception ignored) {}
                }

                daily
                        .computeIfAbsent(date, k -> new HashMap<>())
                        .computeIfAbsent(payment, k -> new Stats())
                        .add(price);

                dayTotal.computeIfAbsent(date, k -> new Stats()).add(price);
                grand.computeIfAbsent(payment, k -> new Stats()).add(price);
                overall.add(price);
            }

        } catch (Exception e) {
            e.printStackTrace();
            return;
        }

        List<String[]> table = new ArrayList<>();

        String[] headerRow = new String[PAYMENT_ORDER.length + 2];
        headerRow[0] = "Date";
        System.arraycopy(PAYMENT_ORDER, 0, headerRow, 1, PAYMENT_ORDER.length);
        headerRow[headerRow.length - 1] = "Total";
        table.add(headerRow);

        for (LocalDate d : daily.keySet()) {
            Map<String, Stats> map = daily.get(d);
            Stats t = dayTotal.get(d);

            String[] row = new String[PAYMENT_ORDER.length + 2];
            row[0] = d.toString();

            for (int i = 0; i < PAYMENT_ORDER.length; i++) {
                Stats s = map.get(PAYMENT_ORDER[i]);
                row[i + 1] = (s != null) ? s.format() : "0 (0)";
            }

            row[row.length - 1] = t.format();
            table.add(row);
        }

        String[] g = new String[PAYMENT_ORDER.length + 2];
        g[0] = "GRAND TOTAL";

        for (int i = 0; i < PAYMENT_ORDER.length; i++) {
            g[i + 1] = grand.getOrDefault(PAYMENT_ORDER[i], new Stats()).format();
        }
        g[g.length - 1] = overall.format();
        table.add(g);

        String totalStr = overall.format();
        String[] totalRow = new String[PAYMENT_ORDER.length + 2];
        totalRow[0] = "TOTAL";
        Arrays.fill(totalRow, 1, totalRow.length, totalStr);
        table.add(totalRow);

        printTable(table);
    }

    private static int findColumn(Map<String, Integer> map, String keyword) {
        for (String k : map.keySet()) {
            if (k.contains(keyword)) return map.get(k);
        }
        throw new RuntimeException("Column not found: " + keyword);
    }

    private static void printTable(List<String[]> rows) {
        int cols = rows.get(0).length;
        int[] widths = new int[cols];

        for (String[] row : rows) {
            boolean bold = row[0].equals("GRAND TOTAL") || row[0].equals("TOTAL");

            for (int c = 0; c < cols; c++) {
                String val = bold ? "**" + row[c] + "**" : row[c];
                widths[c] = Math.max(widths[c], val.length());
            }
        }

        StringBuilder line = new StringBuilder("+");
        for (int w : widths) line.append("-".repeat(w + 2)).append("+");

        System.out.println(line);
        printRow(rows.get(0), widths);
        System.out.println(line);

        for (int i = 1; i < rows.size(); i++) {
            printRow(rows.get(i), widths);
            if (rows.get(i)[0].equals("GRAND TOTAL")) {
                System.out.println(line);
            }
        }

        System.out.println(line);
    }

    private static void printRow(String[] row, int[] widths) {
        boolean bold = row[0].equals("GRAND TOTAL") || row[0].equals("TOTAL");

        System.out.print("|");
        for (int c = 0; c < row.length; c++) {
            String val = bold ? "**" + row[c] + "**" : row[c];

            if (c == 0) {
                System.out.printf(" %-"+widths[c]+"s |", val);
            } else {
                System.out.printf(" %"+widths[c]+"s |", val);
            }
        }
        System.out.println();
    }
}