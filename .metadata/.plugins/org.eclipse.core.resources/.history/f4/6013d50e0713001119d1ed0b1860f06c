package com.everycred.pages;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;

public class SubjectPage {

    WebDriver driver;

    public SubjectPage(WebDriver driver) {
        this.driver = driver;
    }

    public void createGroup() throws Exception {

        System.out.println("✔ Create Group");

        driver.findElement(By.id("groupName"))
              .sendKeys("Employee Department");

        driver.findElement(By.xpath("//button[normalize-space()='Create Group']"))
              .click();

        Thread.sleep(3000);
    }

    public void createSubjectFlow() throws Exception {

        System.out.println("✔ Create Subject");

        driver.findElement(By.xpath("//button[normalize-space()='Create New']")).click();
        driver.findElement(By.xpath("//span[normalize-space()='Create Subject']")).click();

        Thread.sleep(3000);

        System.out.println("✔ Fill Subject Form");

        driver.findElement(By.id("subjectName"))
              .sendKeys("Employee ID Card");

        driver.findElement(By.xpath("//span[@aria-label='Search groups...']")).click();
        driver.findElement(By.xpath("//li[@id='group_1']")).click();

        driver.findElement(By.id("credentialTitle"))
              .sendKeys("Employee ID Card Certificate");

        driver.findElement(By.id("description"))
              .sendKeys("Employee ID Card Certificate 2026");

        Thread.sleep(2000);

        System.out.println("✔ Click Next");
        driver.findElement(By.xpath("//button[normalize-space()='Next']")).click();

        Thread.sleep(3000);

        System.out.println("✔ Open Appearance Tab");
        System.out.println("✔ Select Verify Layout → theme_1");

        driver.findElement(By.xpath("//p-select[@id='verifierDesign']//div")).click();
        driver.findElement(By.xpath("//li[normalize-space()='theme_1']")).click();

        Thread.sleep(2000);

        System.out.println("✔ Click Next");
        driver.findElement(By.xpath("//button[normalize-space()='Next']")).click();

        System.out.println("✅ FLOW COMPLETED SUCCESSFULLY");
    }
}
