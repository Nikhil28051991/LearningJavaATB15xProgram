package com.everycred.automation;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import io.github.bonigarcia.wdm.WebDriverManager;

public class EveryCredLogin {

    public static void main(String[] args) {

        WebDriverManager.chromedriver().setup();
        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();

        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(60));
        JavascriptExecutor js = (JavascriptExecutor) driver;

        try {

            // ================= LOGIN =================
            driver.get("https://demo-dcs-issuer-us.everycred.com/auth/login");

            wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("email")))
                    .sendKeys("admin.albuquerque@yopmail.com");

            driver.findElement(By.cssSelector("input[type='password']"))
                    .sendKeys("Everycred@123");

            driver.findElement(By.xpath("//button[@type='submit']")).click();

            wait.until(ExpectedConditions.urlContains("issuer"));

            System.out.println("✅ Login successful");

            // ================= CLICK SUBJECTS =================
            WebElement subjects = wait.until(
                    ExpectedConditions.elementToBeClickable(
                            By.xpath("//a[normalize-space()='Subjects']")));

            js.executeScript("arguments[0].click();", subjects);

            System.out.println("✅ Clicked Subjects");

            // ================= CLICK CREATE NEW =================
            WebElement createNew = wait.until(
                    ExpectedConditions.elementToBeClickable(
                            By.xpath("//button[normalize-space()='Create New']")));

            createNew.click();

            System.out.println("✅ Clicked Create New");

            // ================= CLICK CREATE GROUP OPTION =================
            WebElement createGroupOption = wait.until(
                    ExpectedConditions.elementToBeClickable(
                            By.xpath("//span[normalize-space()='Create Group']")));

            createGroupOption.click();

            System.out.println("✅ Clicked Create Group option");

            // ================= WAIT FOR MODAL DIALOG =================
            WebElement dialog = wait.until(
                    ExpectedConditions.visibilityOfElementLocated(
                            By.xpath("//div[@role='dialog']")));

            System.out.println("✅ Create Group dialog visible");

            // ================= LOCATE GROUP NAME INPUT INSIDE DIALOG =================
            WebElement groupInput = dialog.findElement(
                    By.xpath(".//input"));

            groupInput.clear();
            groupInput.sendKeys("Employee ID Card");

            System.out.println("✅ Entered Employee ID Card");

            // ================= CLICK CREATE GROUP BUTTON INSIDE DIALOG =================
            WebElement createBtn = dialog.findElement(
                    By.xpath(".//button[normalize-space()='Create Group']"));

            createBtn.click();

            System.out.println("✅ Clicked Create Group button");

            Thread.sleep(5000);

        } catch (Exception e) {
            e.printStackTrace();
        }

        // driver.quit();
    }
}
