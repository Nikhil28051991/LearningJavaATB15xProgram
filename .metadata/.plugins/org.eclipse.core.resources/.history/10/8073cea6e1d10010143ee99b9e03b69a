package com.example.socketio_loadtest;

import io.socket.client.IO;
import io.socket.client.Socket;
import org.json.JSONObject;

import java.util.*;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicInteger;

public class App {

    // ----- CONFIG -----
    private static final String SOCKET_URL = "https://api.demo.simplertoday.ai";
    private static final int DURATION_SECONDS = 120;   // run for 2 minutes
    private static final int ARRIVAL_RATE = 5;         // users per second
    private static final int MAX_VUS = 500;            // max concurrent users
    private static final boolean FORCE_WEBSOCKET = true;
    private static final String HEADER_X_CLIENT_TYPE = "Web_Maverick";
    private static final String HEADER_ORIGIN = "https://demo.simplertoday.ai";
    private static final int RESPONSE_TIMEOUT_MS = 10_000;

    private static final String EVENT_NAME = "client-response";

    // ----- Runtime stats -----
    private final AtomicInteger activeVUs = new AtomicInteger(0);
    private final AtomicInteger totalAttempts = new AtomicInteger(0);
    private final AtomicInteger successes = new AtomicInteger(0);
    private final AtomicInteger failures = new AtomicInteger(0);
    private final List<Long> latencies = Collections.synchronizedList(new ArrayList<>());

    // Executor services
    private final ScheduledExecutorService scheduler = Executors.newScheduledThreadPool(2);
    private final ExecutorService vuExecutor = Executors.newCachedThreadPool();

    public static void main(String[] args) throws Exception {
        App test = new App();
        test.run();
    }

    public void run() throws Exception {
        System.out.println("Starting Socket.IO load test");
        System.out.printf("Target: %s, duration: %ds, arrivalRate: %d/s, maxVusers: %d%n",
                SOCKET_URL, DURATION_SECONDS, ARRIVAL_RATE, MAX_VUS);

        long intervalMs = 1000L / ARRIVAL_RATE;

        final Runnable arrivalTask = () -> {
            if (activeVUs.get() < MAX_VUS) {
                vuExecutor.submit(this::virtualUserFlow);
            }
        };

        final ScheduledFuture<?> arrivalHandle =
                scheduler.scheduleAtFixedRate(arrivalTask, 0, intervalMs, TimeUnit.MILLISECONDS);

        scheduler.schedule(() -> {
            arrivalHandle.cancel(false);
            System.out.println("Arrival phase ended. No more VUs will be started.");
        }, DURATION_SECONDS, TimeUnit.SECONDS);

        scheduler.schedule(this::shutdownAndReport, DURATION_SECONDS + 20, TimeUnit.SECONDS);

        Thread.sleep((DURATION_SECONDS + 25) * 1000L);
    }
    
    private static String generateObjectId() {
        byte[] bytes = new byte[12];
        new java.security.SecureRandom().nextBytes(bytes);

        StringBuilder sb = new StringBuilder();
        for (byte b : bytes) {
            sb.append(String.format("%02x", b));
        }
        return sb.toString();
    }


    private void virtualUserFlow() {
        activeVUs.incrementAndGet();
        totalAttempts.incrementAndGet();
        long startTime = System.nanoTime();

        Socket socket = null;

        try {
            IO.Options opts = new IO.Options();
            if (FORCE_WEBSOCKET) opts.transports = new String[]{"websocket"};

            Map<String, List<String>> headers = new HashMap<>();
            headers.put("x-client-type", Arrays.asList(HEADER_X_CLIENT_TYPE));
            headers.put("origin", Arrays.asList(HEADER_ORIGIN));
            opts.extraHeaders = headers;
            opts.reconnection = false;

            socket = IO.socket(SOCKET_URL, opts);
            final Socket finalSocket = socket;

            final CountDownLatch latch = new CountDownLatch(1);
            final AtomicInteger status = new AtomicInteger(0);

            // 🔥 Generate NEW values per user
            String conversationId = generateObjectId();
            String uuid = UUID.randomUUID().toString();

            JSONObject payload = new JSONObject()
                    .put("tenantId", "675ff2ead0b057be61db7650")
                    .put("stage", "conversation")
                    .put("content", "When can I file a complaint?")
                    .put("role", "user")
                    .put("complaint_details", JSONObject.NULL)
                    .put("conversation_id", conversationId)  // added
                    .put("uuid", uuid);                     // replaced dynamic value

            finalSocket.on(Socket.EVENT_CONNECT, args -> {
                finalSocket.emit(EVENT_NAME, payload);
            });

            finalSocket.on(Socket.EVENT_CONNECT_ERROR, args -> {
                status.set(-1);
                latch.countDown();
            });

            finalSocket.on("error", args -> {
                status.set(-1);
                latch.countDown();
            });

            finalSocket.connect();

            boolean ok = latch.await(RESPONSE_TIMEOUT_MS, TimeUnit.MILLISECONDS);

            long latencyMs = (System.nanoTime() - startTime) / 1_000_000;
            latencies.add(latencyMs);

            if (ok && status.get() == 1) successes.incrementAndGet();
            else failures.incrementAndGet();

        } catch (Exception ex) {
            failures.incrementAndGet();
        } finally {
            if (socket != null && socket.connected()) socket.disconnect();
            activeVUs.decrementAndGet();
        }
    }

    private void shutdownAndReport() {
        try {
            System.out.println("Shutting down executors...");
            vuExecutor.shutdown();
            scheduler.shutdown();

            vuExecutor.awaitTermination(5, TimeUnit.SECONDS);
            scheduler.awaitTermination(5, TimeUnit.SECONDS);
        } catch (InterruptedException ignored) {}

        int total = totalAttempts.get();
        int succ = successes.get();
        int fail = failures.get();

        long min = Long.MAX_VALUE, max = Long.MIN_VALUE, sum = 0;
        if (latencies.isEmpty()) min = max = sum = 0;
        else {
            for (long v : latencies) {
                if (v < min) min = v;
                if (v > max) max = v;
                sum += v;
            }
        }
        double avg = latencies.isEmpty() ? 0 : ((double) sum) / latencies.size();

        System.out.println("---- TEST SUMMARY ----");
        System.out.printf("Total attempts: %d%n", total);
        System.out.printf("Successes: %d, Failures: %d%n", succ, fail);
        System.out.printf("Active VUs at end: %d%n", activeVUs.get());
        System.out.printf("Latency (ms) - min: %d, avg: %.2f, max: %d%n", min, avg, max);
        System.out.println("----------------------");
    }
}
